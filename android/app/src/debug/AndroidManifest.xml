<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: fall back to the Skia renderer instead of Impeller.
         The Android emulator's Vulkan implementation mis-composites translucent
         layers — a dialog's barrier scrim paints fully opaque, so the language
         picker on first launch turns the whole screen black and the app looks
         hung. Real devices render Impeller correctly and it's the faster
         backend, so this override deliberately lives in the debug manifest
         only: release and profile builds are untouched and still ship Impeller.

         Remove this once the emulator's Vulkan driver handles alpha
         compositing correctly. -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
