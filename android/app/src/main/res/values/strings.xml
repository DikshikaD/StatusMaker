    <!-- Shown under Android Settings → Apps → Notifications. Follows the
         phone's locale (values-hi/ has the Hindi copy). -->
    <string name="notification_channel_likes_name">Likes &amp; remixes</string>
    <string name="notification_channel_likes_desc">When someone likes your status or uses your template</string>
</resources>
