<?xml version="1.0" encoding="utf-8"?>
<!-- The only files the app hands to other apps (WhatsApp/Instagram/Facebook)
     via the share FileProvider: <cache>/share/, written by shareDir() in
     lib/shared/utils/share_dir.dart. Nothing else in internal storage (session
     prefs, databases) is reachable through a content:// URI. -->
<paths>
    <cache-path name="shared_cache" path="share/" />
</paths>
