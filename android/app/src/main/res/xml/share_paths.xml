<?xml version="1.0" encoding="utf-8"?>
<!-- Files the app may hand to other apps (WhatsApp/Instagram/Facebook) via the
     share FileProvider. Exported status PNGs are written to the cache dir by
     editor_export.dart's writeTempPng(). -->
<paths>
    <cache-path name="shared_cache" path="." />
    <files-path name="shared_files" path="." />
    <external-cache-path name="shared_external_cache" path="." />
</paths>
